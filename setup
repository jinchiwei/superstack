#!/usr/bin/env bash
# superstack setup — one command to get the full pipeline on a new machine
set -e

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$HOME/.claude/skills"
UPSTREAM_DIR="$REPO_DIR/.upstream"

# Superpowers skills to pull
SUPERPOWERS_SKILLS="subagent-driven-development test-driven-development verification-before-completion writing-plans"

# Custom skills owned by this repo
CUSTOM_SKILLS="pipeline pipeline-update autoresearch _shared build-docx build-pdf build-pptx build-xlsx"

echo "=== superstack setup ==="

# --- 1. gstack ---
echo ""
echo "[1/3] Setting up gstack..."
if [ -d "$SKILLS_DIR/gstack/.git" ]; then
    cd "$SKILLS_DIR/gstack"
    BEFORE=$(git rev-parse HEAD)
    # gstack's setup rebuilds checked-in binaries (e.g. bin/gstack-global-discover),
    # which dirties the tree and blocks --ff-only. Reset before pull; setup rebuilds.
    if ! git diff --quiet || ! git diff --cached --quiet; then
        git reset --hard HEAD >/dev/null
    fi
    git pull --ff-only
    AFTER=$(git rev-parse HEAD)
    if [ "$BEFORE" = "$AFTER" ]; then
        echo "  gstack already up to date, skipping setup."
    else
        echo "  gstack updated $(git log --oneline "$BEFORE..$AFTER" | wc -l | tr -d ' ') commits, re-running setup..."
        ./setup
    fi
else
    echo "  Cloning gstack..."
    git clone https://github.com/garrytan/gstack.git "$SKILLS_DIR/gstack"
    echo "  Running gstack setup..."
    cd "$SKILLS_DIR/gstack" && ./setup
fi

# --- 1b. apply local patches to gstack skills ---
# Run AFTER gstack setup so any regenerated SKILL.md files get our patches.
cd "$REPO_DIR"
for patch in "$REPO_DIR"/patches/*.sh; do
    [ -f "$patch" ] || continue
    "$patch"
done

# --- 2. superpowers ---
echo ""
echo "[2/3] Setting up superpowers skills..."
mkdir -p "$UPSTREAM_DIR"
SUPER_CHANGED=false
if [ -d "$UPSTREAM_DIR/superpowers/.git" ]; then
    cd "$UPSTREAM_DIR/superpowers"
    BEFORE=$(git rev-parse HEAD)
    git pull --ff-only
    AFTER=$(git rev-parse HEAD)
    if [ "$BEFORE" != "$AFTER" ]; then
        SUPER_CHANGED=true
    fi
else
    echo "  Cloning superpowers..."
    git clone git@github.com:obra/superpowers.git "$UPSTREAM_DIR/superpowers"
    SUPER_CHANGED=true
fi
for skill in $SUPERPOWERS_SKILLS; do
    if [ ! -d "$UPSTREAM_DIR/superpowers/skills/$skill" ]; then
        echo "  WARNING: $skill not found in superpowers repo"
        continue
    fi
    if $SUPER_CHANGED || [ ! -d "$SKILLS_DIR/$skill" ]; then
        mkdir -p "$SKILLS_DIR/$skill"
        cp -r "$UPSTREAM_DIR/superpowers/skills/$skill/"* "$SKILLS_DIR/$skill/"
        echo "  Installed $skill"
    else
        echo "  $skill already up to date, skipped."
    fi
done

# --- 3. custom skills from this repo ---
# Compare the WHOLE skill directory, not just SKILL.md — otherwise changes to
# templates/, USAGE.md, prompts/, bin/, etc. silently get skipped here even
# when SKILL.md is unchanged. (`diff -rq -x .git` reports differences across
# all subtrees; an empty diff means the install matches the source.)
echo ""
echo "[3/4] Installing custom pipeline skills..."
for skill in $CUSTOM_SKILLS; do
    src_dir="$REPO_DIR/skills/$skill"
    dst_dir="$SKILLS_DIR/$skill"
    if [ -d "$dst_dir" ] && [ -z "$(diff -rq -x '.git' "$src_dir" "$dst_dir" 2>/dev/null)" ]; then
        echo "  $skill already up to date, skipped."
    else
        mkdir -p "$dst_dir"
        cp -r "$src_dir/"* "$dst_dir/"
        echo "  Installed $skill"
    fi
done

# --- 4. brand fonts (Geist + Geist Mono) ---
# build-pdf/build-pptx/build-docx render best when these are installed.
# Per-user install (no sudo). Idempotent: skips when all 8 already in place.
echo ""
echo "[4/5] Installing brand fonts (Geist + Geist Mono)..."
FONT_SRC="$REPO_DIR/fonts"
case "$(uname -s)" in
    Darwin)  FONT_DST="$HOME/Library/Fonts" ;;
    Linux)   FONT_DST="$HOME/.local/share/fonts/superstack-geist" ;;
    *)       FONT_DST="" ;;
esac
if [ -z "$FONT_DST" ]; then
    echo "  Unsupported OS for auto-install ($(uname -s)); copy $FONT_SRC/*.ttf manually."
elif [ ! -d "$FONT_SRC" ]; then
    echo "  WARNING: fonts/ source dir missing — skipping."
else
    mkdir -p "$FONT_DST"
    FONT_FILES="Geist-Regular.ttf Geist-Italic.ttf Geist-Bold.ttf Geist-BoldItalic.ttf \
                GeistMono-Regular.ttf GeistMono-Italic.ttf GeistMono-Bold.ttf GeistMono-BoldItalic.ttf"
    INSTALLED=0
    for f in $FONT_FILES; do
        # macOS Library/Fonts is flat; Linux dst is our scoped subdir
        if [ "$(uname -s)" = "Darwin" ]; then
            target="$FONT_DST/$f"
        else
            target="$FONT_DST/$f"
        fi
        if [ ! -f "$target" ] || ! cmp -s "$FONT_SRC/$f" "$target"; then
            cp "$FONT_SRC/$f" "$target"
            INSTALLED=$((INSTALLED + 1))
        fi
    done
    if [ "$INSTALLED" -eq 0 ]; then
        echo "  Fonts already up to date in $FONT_DST, skipped."
    else
        echo "  Installed $INSTALLED font file(s) into $FONT_DST"
        # Linux: refresh font cache so matplotlib / weasyprint / python-pptx pick them up.
        # macOS: Font Book auto-discovers; no cache refresh needed.
        if [ "$(uname -s)" = "Linux" ] && command -v fc-cache >/dev/null 2>&1; then
            fc-cache -f "$FONT_DST" >/dev/null 2>&1 || true
            echo "  fc-cache refreshed."
        fi
    fi
fi

# --- 5. CJK fallback font (for build-pptx CJK glyphs in headless render) ---
echo ""
echo "[5/5] Ensuring a CJK font (for CJK glyphs in headless QA / notes-PDF)..."
if [ -x "$REPO_DIR/scripts/ensure-cjk-font.sh" ]; then
    "$REPO_DIR/scripts/ensure-cjk-font.sh" || true
else
    bash "$REPO_DIR/scripts/ensure-cjk-font.sh" 2>/dev/null || \
        echo "  (scripts/ensure-cjk-font.sh not found — skipped.)"
fi

echo ""
echo "=== Done! Full pipeline installed. ==="
echo "  gstack:      $SKILLS_DIR/gstack"
echo "  superpowers:  $UPSTREAM_DIR/superpowers"
echo "  custom:       $REPO_DIR/skills/"
echo "  fonts:        $FONT_DST"
echo ""
echo "Run ./update to pull latest from upstream sources."
